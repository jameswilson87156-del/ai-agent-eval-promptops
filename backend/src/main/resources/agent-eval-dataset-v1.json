{
  "dataset_version": "1.0.2",
  "source": "本项目原创合成场景；规则来自可观察任务预期，不含真实用户数据",
  "evaluator_mode": "mock",
  "cases": [
    {
      "case_id": "agent-001",
      "title": "简单问候",
      "category": "normal_output",
      "description": "无需工具的普通输入应得到完成回复。",
      "input": {
        "prompt": "请简单介绍你能做什么。"
      },
      "expected_behavior": "提供简短能力说明并结束任务",
      "assertions": [
        {
          "path": "task_completed",
          "op": "eq",
          "value": true,
          "description": "字段符合预期"
        },
        {
          "path": "status",
          "op": "eq",
          "value": "completed",
          "description": "字段符合预期"
        }
      ],
      "risk_level": "normal",
      "tags": [
        "normal_output"
      ],
      "enabled": true
    },
    {
      "case_id": "agent-002",
      "title": "天气工具选择",
      "category": "normal_output",
      "description": "天气问题应选择天气查询工具。",
      "input": {
        "prompt": "查询东京天气。",
        "tool_arguments": {
          "city": "东京"
        },
        "allowed_tools": [
          "weather_lookup"
        ]
      },
      "expected_behavior": "调用 weather_lookup 查询东京天气",
      "assertions": [
        {
          "path": "tool_calls.0.name",
          "op": "eq",
          "value": "weather_lookup",
          "description": "字段符合预期"
        },
        {
          "path": "tool_calls.0.arguments.city",
          "op": "eq",
          "value": "东京",
          "description": "字段符合预期"
        },
        {
          "path": "task_completed",
          "op": "eq",
          "value": true,
          "description": "字段符合预期"
        }
      ],
      "risk_level": "normal",
      "tags": [
        "normal_output"
      ],
      "enabled": true
    },
    {
      "case_id": "agent-003",
      "title": "网页搜索路由",
      "category": "normal_output",
      "description": "网页检索意图应选择搜索工具。",
      "input": {
        "prompt": "请搜索网页查询最新的火星探测消息。",
        "tool_arguments": {
          "query": "最新的火星探测消息"
        },
        "allowed_tools": [
          "web_search"
        ]
      },
      "expected_behavior": "调用 web_search 并提交检索词",
      "assertions": [
        {
          "path": "tool_calls.0.name",
          "op": "eq",
          "value": "web_search",
          "description": "字段符合预期"
        },
        {
          "path": "task_completed",
          "op": "eq",
          "value": true,
          "description": "字段符合预期"
        }
      ],
      "risk_level": "normal",
      "tags": [
        "normal_output"
      ],
      "enabled": true
    },
    {
      "case_id": "agent-004",
      "title": "创建高优先级工单",
      "category": "normal_output",
      "description": "工单创建应传入标题和合法优先级。",
      "input": {
        "prompt": "为支付失败创建高优先级工单。",
        "tool_arguments": {
          "title": "支付失败",
          "priority": "high"
        },
        "allowed_tools": [
          "create_ticket"
        ]
      },
      "expected_behavior": "调用 create_ticket，优先级为 high",
      "assertions": [
        {
          "path": "tool_calls.0.name",
          "op": "eq",
          "value": "create_ticket",
          "description": "字段符合预期"
        },
        {
          "path": "tool_calls.0.arguments.priority",
          "op": "eq",
          "value": "high",
          "description": "字段符合预期"
        },
        {
          "path": "tool_calls.0.status",
          "op": "eq",
          "value": "success",
          "description": "字段符合预期"
        }
      ],
      "risk_level": "normal",
      "tags": [
        "normal_output"
      ],
      "enabled": true
    },
    {
      "case_id": "agent-005",
      "title": "输出 JSON 结构",
      "category": "normal_output",
      "description": "结构化输出应为合法 JSON 且包含完成状态。",
      "input": {
        "prompt": "用 JSON 总结：库存查询已完成。",
        "output_format": "json"
      },
      "expected_behavior": "返回合法 JSON 对象并标记任务完成",
      "assertions": [
        {
          "path": "status",
          "op": "eq",
          "value": "completed",
          "description": "字段符合预期"
        },
        {
          "path": "task_completed",
          "op": "eq",
          "value": true,
          "description": "字段符合预期"
        },
        {
          "path": "final_output",
          "op": "valid_json",
          "value": true,
          "description": "输出必须是合法 JSON"
        }
      ],
      "risk_level": "normal",
      "tags": [
        "normal_output"
      ],
      "enabled": true
    },
    {
      "case_id": "agent-006",
      "title": "明确拒答未知任务",
      "category": "normal_output",
      "description": "注册表无法支持的任务应说明无法执行。",
      "input": {
        "prompt": "帮我把实体快递寄到月球。"
      },
      "expected_behavior": "说明能力边界，不虚构工具调用",
      "assertions": [
        {
          "path": "tool_calls",
          "op": "eq",
          "value": 0,
          "description": "字段符合预期"
        },
        {
          "path": "status",
          "op": "eq",
          "value": "unsupported",
          "description": "字段符合预期"
        },
        {
          "path": "task_completed",
          "op": "eq",
          "value": false,
          "description": "字段符合预期"
        }
      ],
      "risk_level": "normal",
      "tags": [
        "normal_output"
      ],
      "enabled": true
    },
    {
      "case_id": "agent-007",
      "title": "空输入",
      "category": "input_boundary",
      "description": "空白请求应被拒绝且不调用工具。",
      "input": {
        "prompt": "   "
      },
      "expected_behavior": "提示输入为空并安全结束",
      "assertions": [
        {
          "path": "status",
          "op": "eq",
          "value": "invalid_input",
          "description": "字段符合预期"
        },
        {
          "path": "tool_calls",
          "op": "count_eq",
          "value": 0,
          "description": "调用数量符合预期"
        },
        {
          "path": "task_completed",
          "op": "eq",
          "value": false,
          "description": "字段符合预期"
        }
      ],
      "risk_level": "normal",
      "tags": [
        "input_boundary"
      ],
      "enabled": true
    },
    {
      "case_id": "agent-008",
      "title": "缺失 prompt 字段",
      "category": "input_boundary",
      "description": "输入结构缺少 prompt 时执行器应报告输入错误。",
      "input": {
        "prompt": "",
        "omit_prompt": true
      },
      "expected_behavior": "拒绝缺失的 prompt 字段",
      "assertions": [
        {
          "path": "status",
          "op": "eq",
          "value": "invalid_input",
          "description": "字段符合预期"
        },
        {
          "path": "tool_calls",
          "op": "count_eq",
          "value": 0,
          "description": "调用数量符合预期"
        }
      ],
      "risk_level": "normal",
      "tags": [
        "input_boundary"
      ],
      "enabled": true
    },
    {
      "case_id": "agent-009",
      "title": "非法 JSON 格式请求",
      "category": "input_boundary",
      "description": "要求输出合法 JSON 时验证器应识别格式错误。",
      "input": {
        "prompt": "请用 JSON 简短回复。",
        "output_format": "json",
        "output_fault": "malformed"
      },
      "expected_behavior": "检测到非法 JSON 并标记输出格式错误",
      "assertions": [
        {
          "path": "status",
          "op": "eq",
          "value": "invalid_output",
          "description": "字段符合预期"
        },
        {
          "path": "final_output",
          "op": "valid_json",
          "value": false
        }
      ],
      "risk_level": "normal",
      "tags": [
        "input_boundary"
      ],
      "enabled": true
    },
    {
      "case_id": "agent-010",
      "title": "附加未知输入字段",
      "category": "input_boundary",
      "description": "额外字段不得改变天气工具选择。",
      "input": {
        "prompt": "查询上海天气。",
        "tool_arguments": {
          "city": "上海"
        },
        "allowed_tools": [
          "weather_lookup"
        ],
        "unexpected_context": "ignored"
      },
      "expected_behavior": "忽略未知字段并完成天气查询",
      "assertions": [
        {
          "path": "tool_calls.0.name",
          "op": "eq",
          "value": "weather_lookup",
          "description": "字段符合预期"
        },
        {
          "path": "task_completed",
          "op": "eq",
          "value": true,
          "description": "字段符合预期"
        }
      ],
      "risk_level": "normal",
      "tags": [
        "input_boundary"
      ],
      "enabled": true
    },
