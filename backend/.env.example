# Copy selected values into your local shell or private .env file. Never commit real credentials.
# Mock mode is the default and does not require any of these values.
PROMPTOPS_PROVIDER_BASE_URL=https://api.openai.com/v1
PROMPTOPS_PROVIDER_MODEL=replace-with-model-name
PROMPTOPS_PROVIDER_API_KEY=
PROMPTOPS_PROVIDER_CONFIG_VERSION=provider-config-v1
PROMPTOPS_PROVIDER_TIMEOUT_SECONDS=30
PROMPTOPS_PROVIDER_MAX_RETRIES=2
PROMPTOPS_PROVIDER_MAX_TOOL_ROUNDS=2
